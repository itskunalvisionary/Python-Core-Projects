     "text": [
      "Total: 2 queries received.\n",
      "Queries: ['Which Country is Biggest', 'Which Laptop is Best?']\n"
     ]
    }
   ],
   "source": [
    "queries = []\n",
    "\n",
    "while True:\n",
    "    q = input(\"Enter your question (or type 'exit' to finish): \")\n",
    "    if q.lower() == 'exit':\n",
    "        break\n",
    "    queries.append(q)\n",
    "\n",
    "print(\"Total:\",len(queries), \"queries received.\")\n",
    "print(\"Queries:\", queries)"
   ]
  },
